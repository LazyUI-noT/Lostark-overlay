<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\GaugeOverlay.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Runs on 19041 (Windows 10 2004: WDA_EXCLUDEFROMCAPTURE). Compiled against 22621 because the
         borderless WGC APIs (GraphicsCaptureAccess, IsBorderRequired) only exist in that projection;
         WgcCapture guards them with OS-version and ApiInformation checks. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon for the tray -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GaugeOverlay.App</RootNamespace>
    <AssemblyName>GaugeOverlay</AssemblyName>
    <Version>0.11.3</Version>
  </PropertyGroup>

  <!-- WinForms is only here for NotifyIcon; keep its names out of the global namespace. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Profiles\**\*" LinkBase="Profiles" CopyToOutputDirectory="PreserveNewest" />
    <!-- 레이아웃 편집기: the screen shown while a profile has no screenshot of its own (reference/No cd.png, a clean 1920×1080 frame). -->
    <Resource Include="Assets/sample-screen.jpg" />
    <Resource Include="Assets/guide/*.png" />
  </ItemGroup>

  <!-- D3D11/DXGI COM wrappers for capture (brings Vortice.DXGI). -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
