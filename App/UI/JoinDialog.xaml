<Window x:Class="GaugeOverlay.App.UI.JoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파티 참가" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ThemeMode="System" ShowInTaskbar="True">
    <StackPanel x:Name="Root">
        <TextBlock Text="호스트에게 받은 토큰을 붙여 넣으세요." Margin="20,20,20,8" />
        <TextBox x:Name="TokenBox" Margin="20,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,20">
            <Button x:Name="JoinButton" Content="참가" IsDefault="True" IsEnabled="False" MinWidth="88" Margin="0,0,8,0" Click="OnJoin" />
            <Button Content="취소" IsCancel="True" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
