<Window x:Class="GaugeOverlay.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GaugeOverlay 설정" Width="1360" Height="820" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <!-- Shell (SettingsWindow.Shell.cs, .TopBar.cs, .Inspector.cs): the top bar (wordmark, 프로필, 편집 중) across, the rail
         on the left, and either 내 오버레이's canvas page (the game screen with the overlay, the inspector of what was
         clicked on the right) or another area's page (its section buttons, then the section's form). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TopBar" Grid.Row="0" Padding="16,8,16,8" BorderThickness="0,0,0,1">
            <DockPanel x:Name="TopBarContent" LastChildFill="False" />
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavHost" Grid.Column="0" Padding="10,12,10,12" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel x:Name="NavFoot" DockPanel.Dock="Bottom" />
                    <StackPanel x:Name="Nav" />
                </DockPanel>
            </Border>
            <Grid x:Name="CanvasPage" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <WrapPanel x:Name="CanvasTools" DockPanel.Dock="Top" Margin="12,8,12,8" />
                    <Border x:Name="CanvasHost" />
                </DockPanel>
                <Border x:Name="InspectorHost" Grid.Column="1" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <StackPanel x:Name="InspectorHead" DockPanel.Dock="Top" Margin="20,14,20,8" />
                        <Border x:Name="InspectorFoot" DockPanel.Dock="Bottom" Padding="20,10,20,12" BorderThickness="0,1,0,0" />
                        <ScrollViewer x:Name="InspectorBody" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Inspector" Margin="20,4,20,20" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel x:Name="SectionPage" Grid.Column="1">
                <StackPanel x:Name="Header" DockPanel.Dock="Top" Margin="24,14,24,0" />
                <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Form" Margin="24,12,24,24" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
