<Window x:Class="GaugeOverlay.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GaugeOverlay 설정" Width="1360" Height="820" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <!-- Shell (SettingsWindow.Shell.cs, .TopBar.cs, .Inspector.cs): the top bar (wordmark, 프로필, 편집 중) across, the rail
         on the left, and either 내 오버레이's canvas page (the game screen with the overlay, the inspector of what was
         clicked on the right) or another area's page (its section buttons, then the section's form). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TopBar" Grid.Row="0" Padding="16,8,16,8" BorderThickness="0,0,0,1">
            <DockPanel x:Name="TopBarContent" LastChildFill="False" />
        </Border>
        <!-- 자동 → 항상 test (tray), shown on every page while on (SettingsWindow.TopBar.cs) -->
        <Border x:Name="AutoTestBanner" Grid.Row="1" Padding="16,6,16,6" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <DockPanel x:Name="AutoTestBannerContent" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavHost" Grid.Column="0" Padding="8,12,8,12" BorderThickness="0,0,1,0">
                <!-- NavTop holds 설정 검색 above the scroll, so it stays in view (ui-audit-2026-11-18, P3) -->
                <DockPanel>
                    <StackPanel x:Name="NavTop" DockPanel.Dock="Top" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Nav" /></ScrollViewer>
                </DockPanel>
            </Border>
            <Grid x:Name="CanvasPage" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- The inspector gives up to 100 px at narrow widths (min 1000: canvas 388 → about 470), 400 from about 1250. -->
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="400" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <StackPanel x:Name="CanvasBadgeHost" DockPanel.Dock="Top" Margin="12,12,12,0" Orientation="Horizontal" />
                    <WrapPanel x:Name="CanvasTools" DockPanel.Dock="Top" Margin="12,8,12,8" />
                    <Border x:Name="CanvasHost" />
                </DockPanel>
                <Border x:Name="InspectorHost" Grid.Column="1" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <StackPanel x:Name="InspectorHead" DockPanel.Dock="Top" Margin="24,12,24,8" />
                        <Border x:Name="InspectorFoot" DockPanel.Dock="Bottom" Padding="24,12,24,12" BorderThickness="0,1,0,0" />
                        <ScrollViewer x:Name="InspectorBody" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Inspector" Margin="24,4,24,24" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel x:Name="SectionPage" Grid.Column="1">
                <StackPanel x:Name="Header" DockPanel.Dock="Top" Margin="24,12,24,0" />
                <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Form" Margin="24,12,24,24" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
