<Window x:Class="GaugeOverlay.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GaugeOverlay 설정" Width="1040" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <!-- Shell (SettingsWindow.Shell.cs): the four areas on the left (a row across the top when narrow), then the area's
         header (title, 편집 중 class, section buttons) that never scrolls, the section's form, and on wide windows the
         overlay preview pinned on the right. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="NavHost" Grid.Row="1" Grid.Column="0" Padding="10,16,10,12" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel x:Name="NavFoot" DockPanel.Dock="Bottom" />
                <StackPanel x:Name="Nav" />
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Grid.Column="1">
            <StackPanel x:Name="Header" DockPanel.Dock="Top" Margin="24,14,24,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Form" Margin="24,12,24,24" />
                </ScrollViewer>
                <ScrollViewer x:Name="PreviewHost" Grid.Column="1" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
