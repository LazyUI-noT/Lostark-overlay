<Window x:Class="GaugeOverlay.App.UI.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GaugeOverlay 디버그 창" Width="600" Height="820" WindowStartupLocation="CenterScreen" ThemeMode="System"
        Topmost="True" ShowActivated="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Table" Margin="16" />
        </ScrollViewer>
        <ToggleButton x:Name="AdjustToggle" Grid.Column="1" Width="30" Padding="0" MinWidth="0" VerticalAlignment="Stretch"
                      ToolTip="인식 위치를 실시간 화면에서 맞춥니다. 펼친 동안만 쓰이고, 적용하면 수동 조정으로 저장합니다.">
            <TextBlock x:Name="AdjustToggleText" Text="수동 조정 ◂">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90" />
                </TextBlock.LayoutTransform>
            </TextBlock>
        </ToggleButton>
        <Border x:Name="AdjustPanel" Grid.Column="2" Width="440" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Thumb x:Name="AdjustResize" Grid.Column="0" Cursor="SizeWE" Opacity="0.35" ToolTip="끌어서 폭을 바꿉니다." />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AdjustHost" Margin="10,16,16,16" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
